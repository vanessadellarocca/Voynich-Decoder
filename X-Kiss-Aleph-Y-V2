class StructuralError(ValueError):
    """Raised at a boundary when a relation would otherwise be lost."""


def require(relation: bool, message: str) -> None:
    """Boundary guard: reject an incomplete relation instead of inventing data."""
    if not relation:
        raise StructuralError(message)


def canonical_json(data: Any) -> str:
    return json.dumps(
        data,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    )


def digest_of(data: Any) -> str:
    return sha256(
        canonical_json(data).encode("utf-8")
    ).hexdigest()


def rotate_pair(
    a: float,
    b: float,
    angle: float,
) -> tuple[float, float]:
    """Invertible two-channel relation; no pole is erased."""
    c = math.cos(angle)
    s = math.sin(angle)
    return a * c - b * s, a * s + b * c


def fold_toward_carrier(
    carrier: float,
    excluded: float,
    openness: float,
) -> tuple[float, float, float]:
    """
    Entropieinversion: Rotate an excluded coordinate toward its carrier.
    Die Leere wird zum Träger, der Schatten wird lesbar.
    Kein Informationsverlust, nur unitäre Faltung.
    """
    angle = -openness * math.atan2(excluded, carrier)
    new_carrier, new_excluded = rotate_pair(carrier, excluded, angle)
    return new_carrier, new_excluded, angle


class Sheet(IntEnum):
    PSYCHE = -1
    SOMA = 1

    @property
    def opposite(self) -> "Sheet":
        return Sheet(-int(self))


@dataclass(frozen=True, slots=True, order=True)
class Address:
    scale: int
    k: int
    sheet: Sheet

    def __post_init__(self) -> None:
        require(self.scale >= 0, "scale must be non-negative")
        object.__setattr__(self, "k", self.k % N_POSITIONS)
        object.__setattr__(self, "sheet", Sheet(self.sheet))

    def to_data(self) -> dict[str, int]:
        return {
            "scale": self.scale,
            "k": self.k,
            "sheet": int(self.sheet),
        }

    @classmethod
    def from_data(cls, data: Mapping[str, Any]) -> "Address":
        return cls(
            scale=int(data["scale"]),
            k=int(data["k"]),
            sheet=Sheet(int(data["sheet"])),
        )


def R(address: Address) -> Address:
    return Address(address.scale, address.k + 1, address.sheet)


def R_inv(address: Address) -> Address:
    return Address(address.scale, address.k - 1, address.sheet)


def X(address: Address, observer_b: int) -> Address:
    return Address(
        address.scale,
        2 * observer_b - address.k,
        address.sheet.opposite,
    )


def Y(address: Address) -> Address:
    return Address(
        address.scale,
        address.k + int(address.sheet),
        address.sheet,
    )


@dataclass(frozen=True, slots=True)
class RelationalState:
    d_form: float
    t_surplus: float
    he_core: float
    alpha_land: float
    shadow_n: float
    real_light_gamma: float
    xi_shol: float
    log_seam_kappa: float
    aiin: float
    edy: float
    void_center: float
    entropy: float
    phase: float

    @property
    def seam_depth(self) -> float:
        return math.exp(self.log_seam_kappa)

    def content_vector(self) -> tuple[float, ...]:
        return (
            self.d_form,
            self.t_surplus,
            self.he_core,
            self.alpha_land,
            self.shadow_n,
            self.real_light_gamma,
            self.xi_shol,
            self.log_seam_kappa,
            self.aiin,
            self.edy,
            self.void_center,
            self.entropy,
        )

    def content_norm2(self) -> float:
        return math.fsum(value * value for value in self.content_vector())

    def to_data(self) -> dict[str, float]:
        return {item.name: float(getattr(self, item.name)) for item in fields(self)}

    @classmethod
    def from_data(cls, data: Mapping[str, Any]) -> "RelationalState":
        return cls(**{item.name: float(data[item.name]) for item in fields(cls)})


