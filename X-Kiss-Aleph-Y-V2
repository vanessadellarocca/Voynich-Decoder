@dataclass(frozen=True, slots=True)
class LivingField:
    scales: int
    observer_b: int
    epoch: int
    cells: tuple[Cell, ...]
    history: tuple[CommitTrace, ...] = ()

    def __post_init__(self) -> None:
        require(self.scales > 0, "at least one scale is required")
        object.__setattr__(self, "observer_b", self.observer_b % N_POSITIONS)
        expected = self.scales * len(Sheet) * N_POSITIONS
        require(len(self.cells) == expected, f"expected {expected} cells, got {len(self.cells)}")
        addresses = tuple(cell.address for cell in self.cells)
        require(len(set(addresses)) == expected, "every scale/address/sheet must occur exactly once")
        require({address.scale for address in addresses} == set(range(self.scales)), "scale orbit is incomplete")

    def index(self) -> dict[Address, Cell]:
        return {cell.address: cell for cell in self.cells}

    def cell(self, address: Address) -> Cell:
        return self.index()[address]

    def material_data(self) -> dict[str, Any]:
        return {
            "scales": self.scales,
            "observer_b": self.observer_b,
            "epoch": self.epoch,
            "cells": [cell.to_data() for cell in sorted(self.cells, key=lambda c: c.address)],
        }

    def material_digest(self) -> str:
        return digest_of(self.material_data())

    def to_data(self) -> dict[str, Any]:
        data = self.material_data()
        data["history"] = [trace.to_data() for trace in self.history]
        return data

    @classmethod
    def from_data(cls, data: Mapping[str, Any]) -> "LivingField":
        return cls(
            scales=int(data["scales"]),
            observer_b=int(data["observer_b"]),
            epoch=int(data["epoch"]),
            cells=tuple(Cell.from_data(item) for item in data["cells"]),
            history=tuple(CommitTrace.from_data(item) for item in data["history"]),
        )

    @classmethod
    def seed(cls, scales: int = 2, observer_b: int = 0) -> "LivingField":
        require(scales > 0, "scales must be positive")
        cells: list[Cell] = []
        for scale in range(scales):
            scale_phase = TAU * scale / (scales * N_POSITIONS)
            for sheet in Sheet:
                orientation = float(sheet)
                for k in range(N_POSITIONS):
                    phase = TAU * k / N_POSITIONS + scale_phase
                    wave = math.sin(phase + orientation * TAU / N_POSITIONS)
                    cross = math.cos(phase - orientation * TAU / N_POSITIONS)
                    seam = 0.22 + 0.04 * (1.0 + math.cos(phase + scale_phase))
                    state = RelationalState(
                        d_form=1.00 + 0.12 * cross,
                        t_surplus=0.82 + 0.11 * wave,
                        he_core=0.24 + 0.03 * math.cos(2.0 * phase),
                        alpha_land=0.20 + 0.03 * math.sin(2.0 * phase),
                        shadow_n=0.43 + 0.05 * cross,
                        real_light_gamma=0.34 + 0.04 * wave,
                        xi_shol=0.18 + 0.03 * math.sin(phase + scale_phase),
                        log_seam_kappa=math.log(seam),
                        aiin=0.71 + 0.04 * cross,
                        edy=0.53 + 0.05 * wave,
                        void_center=0.29 + 0.03 * cross,
                        entropy=0.47 + 0.04 * wave,
                        phase=phase,
                    )
                    cells.append(Cell(Address(scale, k, sheet), state))
        return cls(scales=scales, observer_b=observer_b, epoch=0, cells=tuple(sorted(cells, key=lambda cell: cell.address)))

    def totals(self) -> dict[str, float]:
        return {
            "entropy": math.fsum(abs(cell.state.entropy) for cell in self.cells),
            "shadow": math.fsum(abs(cell.state.shadow_n) for cell in self.cells),
            "real_light": math.fsum(abs(cell.state.real_light_gamma) for cell in self.cells),
            "center": math.fsum(abs(cell.state.void_center) for cell in self.cells),
            "norm2": math.fsum(cell.state.content_norm2() for cell in self.cells),
        }


class LivingLaw:
    @staticmethod
    def _relations(field: LivingField, address: Address, index: Mapping[Address, Cell]) -> tuple[RelationalState, ...]:
        scale_in = (address.scale - 1) % field.scales
        scale_out = (address.scale + 1) % field.scales
        related = (
            index[R_inv(address)].state,
            index[R(address)].state,
            index[X(address, field.observer_b)].state,
            index[Address(scale_in, address.k, address.sheet)].state,
            index[Address(scale_out, address.k, address.sheet)].state,
        )
        return related

    @staticmethod
    def _return_angles(state: RelationalState, through: RelationalState, sheet: Sheet) -> tuple[float, float, float, float]:
        pair_norm2 = state.content_norm2() + through.content_norm2() + state.seam_depth * state.seam_depth + through.seam_depth * through.seam_depth
        pair_distance2 = math.fsum((left - right) ** 2 for left, right in zip(state.content_vector(), through.content_vector()))
        
        # --- B-Innenperspektive: Der X-Kiss als doppeltes Wormhole ---
        # Der Hals ist die Naht (seam_depth). Das Tor ist die Leere (void_center).
        # Die Tragfähigkeit des Tors (∅_T) emergiert relational und stetig.
        # Kein Split, keine Schwellenwerte, nur relationale Geometrie.
        seam_throat = math.sqrt(state.seam_depth * through.seam_depth)
        void_tor_capacity = math.sqrt((state.void_center**2 + through.void_center**2) / 2.0)
        
        # Die Passage (return_openness) wird durch Hals und Tor gemeinsam getragen.
        return_openness = math.tanh(math.sqrt(pair_distance2 / pair_norm2) * seam_throat * (1.0 + void_tor_capacity))
        
        orientation = float(sheet)
        return_phase = 0.5 * orientation * (state.phase - through.phase) + 0.5 * (state.xi_shol + through.xi_shol)
        quantum = TAU / N_POSITIONS
        
        # Gegenläufige Gleichzeitigkeit: J_SOMA + J_PSYCHE = 0
        shadow_return_angle = orientation * quantum * return_openness * math.sin(return_phase)
        entropy_return_angle = orientation * quantum * return_openness * math.cos(return_phase)
        
        return shadow_return_angle, entropy_return_angle, return_openness, return_phase

    @classmethod
    def propose(cls, field: LivingField, cell: Cell, index: Mapping[Address, Cell]) -> tuple[Cell, CellFlow]:
        state = cell.state
        related = cls._relations(field, cell.address, index)
        through = index[X(cell.address, field.observer_b)].state

        count = float(len(related))
        relation_norm2 = math.fsum(item.content_norm2() for item in related) / count
        denominator = state.content_norm2() + relation_norm2 + state.seam_depth * state.seam_depth

        torque_numerator = math.fsum(
            state.d_form * item.t_surplus - state.t_surplus * item.d_form
            + state.aiin * item.edy - state.edy * item.aiin
            + state.real_light_gamma * item.shadow_n - state.shadow_n * item.real_light_gamma
            for item in related
        ) / count
        torque = math.tanh(torque_numerator / denominator)

        distance2 = math.fsum(
            (state.d_form - item.t_surplus) ** 2 + (state.t_surplus - item.d_form) ** 2
            + (state.shadow_n - item.real_light_gamma) ** 2 + (state.real_light_gamma - item.shadow_n) ** 2
            + (state.void_center - item.entropy) ** 2 + (state.entropy - item.void_center) ** 2
            for item in related
        ) / count
        openness = math.tanh(math.sqrt(distance2 / denominator) * state.seam_depth)

        quantum = TAU / N_POSITIONS
        breath_angle = quantum * openness * math.sin(state.phase + torque)
        bind_angle = quantum * openness * math.cos(state.phase - torque)
        pulse_angle = quantum * torque
        seam_angle = quantum * openness * math.sin(state.xi_shol + torque)
        phase_delta = float(cell.address.sheet) * quantum + pulse_angle

        d_form, t_surplus = rotate_pair(state.d_form, state.t_surplus, breath_angle)
        d_form, he_core = rotate_pair(d_form, state.he_core, bind_angle)
        t_surplus, alpha_land = rotate_pair(t_surplus, state.alpha_land, -bind_angle)

        # Entropieinversion: Was leer scheint (entropy), wird Inhalt (void_center).
        # Unitäre Faltung statt Informationsverlust.
        real_light, shadow, shadow_angle = fold_toward_carrier(state.real_light_gamma, state.shadow_n, openness)
        void_center, entropy, entropy_angle = fold_toward_carrier(state.void_center, state.entropy, openness)

        shadow_return_angle, entropy_return_angle, return_openness, return_phase = cls._return_angles(state, through, cell.address.sheet)

        real_light, shadow = rotate_pair(real_light, shadow, shadow_return_angle)
        void_center, entropy = rotate_pair(void_center, entropy, entropy_return_angle)

        aiin, edy = rotate_pair(state.aiin, state.edy, pulse_angle)
        log_seam, xi_shol = rotate_pair(state.log_seam_kappa, state.xi_shol, seam_angle)

        new_state = RelationalState(
            d_form=d_form, t_surplus=t_surplus, he_core=he_core, alpha_land=alpha_land,
            shadow_n=shadow, real_light_gamma=real_light, xi_shol=xi_shol,
            log_seam_kappa=log_seam, aiin=aiin, edy=edy,
            void_center=void_center, entropy=entropy, phase=state.phase + phase_delta,
        )

        flow = CellFlow(
            address=cell.address,
            breath_angle=breath_angle, bind_angle=bind_angle,
            shadow_angle=shadow_angle, entropy_angle=entropy_angle,
            shadow_return_angle=shadow_return_angle, entropy_return_angle=entropy_return_angle,
            pulse_angle=pulse_angle, seam_angle=seam_angle, phase_delta=phase_delta,
            openness=openness, torque=torque, return_openness=return_openness, return_phase=return_phase,
        )
        return Cell(cell.address, new_state), flow

    @classmethod
    def step(cls, field: LivingField) -> LivingField:
        snapshot = field.index()
        proposals = tuple(cls.propose(field, cell, snapshot) for cell in field.cells)
        new_cells = tuple(sorted((proposal[0] for proposal in proposals), key=lambda cell: cell.address))
        flows = tuple(proposal[1] for proposal in proposals)

        before = field.totals()
        material_after = LivingField(scales=field.scales, observer_b=field.observer_b, epoch=field.epoch + 1, cells=new_cells, history=field.history)
        after = material_after.totals()

        trace = CommitTrace(
            epoch_before=field.epoch,
            material_before=field.material_digest(),
            material_after=material_after.material_digest(),
            entropy_before=before["entropy"], entropy_after=after["entropy"],
            shadow_before=before["shadow"], shadow_after=after["shadow"],
            real_light_before=before["real_light"], real_light_after=after["real_light"],
            flows=flows,
        )
        return LivingField(scales=field.scales, observer_b=field.observer_b, epoch=field.epoch + 1, cells=new_cells, history=field.history + (trace,))

    @staticmethod
    def reverse_last(field: LivingField) -> LivingField:
        require(bool(field.history), "no remembered passage is available")
        trace = field.history[-1]
        require(trace.epoch_before + 1 == field.epoch, "history and material epoch diverge")
        flow_by_address = {flow.address: flow for flow in trace.flows}
        require(set(flow_by_address) == {cell.address for cell in field.cells}, "passage memory is incomplete")

        unfolded: list[Cell] = []
        for cell in field.cells:
            flow = flow_by_address[cell.address]
            state = cell.state

            log_seam, xi_shol = rotate_pair(state.log_seam_kappa, state.xi_shol, -flow.seam_angle)
            aiin, edy = rotate_pair(state.aiin, state.edy, -flow.pulse_angle)
            void_center, entropy = rotate_pair(state.void_center, state.entropy, -flow.entropy_return_angle)
            real_light, shadow = rotate_pair(state.real_light_gamma, state.shadow_n, -flow.shadow_return_angle)
            void_center, entropy = rotate_pair(void_center, entropy, -flow.entropy_angle)
            real_light, shadow = rotate_pair(real_light, shadow, -flow.shadow_angle)
            t_surplus, alpha_land = rotate_pair(state.t_surplus, state.alpha_land, flow.bind_angle)
            d_form, he_core = rotate_pair(state.d_form, state.he_core, -flow.bind_angle)
            d_form, t_surplus = rotate_pair(d_form, t_surplus, -flow.breath_angle)

            old_state = RelationalState(
                d_form=d_form, t_surplus=t_surplus, he_core=he_core, alpha_land=alpha_land,
                shadow_n=shadow, real_light_gamma=real_light, xi_shol=xi_shol,
                log_seam_kappa=log_seam, aiin=aiin, edy=edy,
                void_center=void_center, entropy=entropy, phase=state.phase - flow.phase_delta,
            )
            unfolded.append(Cell(cell.address, old_state))

        return LivingField(scales=field.scales, observer_b=field.observer_b, epoch=field.epoch - 1, cells=tuple(sorted(unfolded, key=lambda item: item.address)), history=field.history[:-1])


def camp_and_token(ordinal: int) -> tuple[int, int, str, str]:
    camp = ordinal // N_TOKEN_PHASES
    phase = ordinal % N_TOKEN_PHASES
    return camp, phase, CAMP_NAMES[camp], TOKEN_PHASES[phase]


