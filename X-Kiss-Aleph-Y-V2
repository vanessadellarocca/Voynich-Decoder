@dataclass(frozen=True, slots=True)
class ScalePacket:
    scale: int
    sections: tuple[CrossSection, ...]
    closure: tuple[Address, Address]

    def to_data(self) -> dict[str, Any]:
        return {
            "scale": self.scale,
            "sections": [section.to_data() for section in self.sections],
            "closure": [self.closure[0].to_data(), self.closure[1].to_data()],
        }

    @classmethod
    def from_data(cls, data: Mapping[str, Any]) -> "ScalePacket":
        closure = tuple(Address.from_data(item) for item in data["closure"])
        require(len(closure) == 2, "closure must join exactly two sequence ends")
        return cls(
            scale=int(data["scale"]),
            sections=tuple(CrossSection.from_data(item) for item in data["sections"]),
            closure=(closure[0], closure[1]),
        )


@dataclass(frozen=True, slots=True)
class ExternalPacket:
    schema: str
    observer_b: int
    cut_k: int
    view_sheet: Sheet
    direction: int
    epoch: int
    scales: int
    levels: tuple[ScalePacket, ...]
    history: tuple[CommitTrace, ...]
    material_digest: str
    packet_digest: str

    def payload_data(self) -> dict[str, Any]:
        return {
            "schema": self.schema, "observer_b": self.observer_b,
            "cut_k": self.cut_k, "view_sheet": int(self.view_sheet),
            "direction": self.direction, "epoch": self.epoch, "scales": self.scales,
            "levels": [level.to_data() for level in self.levels],
            "history": [trace.to_data() for trace in self.history],
            "material_digest": self.material_digest,
        }

    def to_data(self) -> dict[str, Any]:
        data = self.payload_data()
        data["packet_digest"] = self.packet_digest
        return data

    def to_json(self, indent: int | None = 2) -> str:
        return json.dumps(self.to_data(), ensure_ascii=False, sort_keys=True, indent=indent)

    @classmethod
    def from_data(cls, data: Mapping[str, Any]) -> "ExternalPacket":
        packet = cls(
            schema=str(data["schema"]), observer_b=int(data["observer_b"]),
            cut_k=int(data["cut_k"]), view_sheet=Sheet(int(data["view_sheet"])),
            direction=int(data["direction"]), epoch=int(data["epoch"]), scales=int(data["scales"]),
            levels=tuple(ScalePacket.from_data(item) for item in data["levels"]),
            history=tuple(CommitTrace.from_data(item) for item in data["history"]),
            material_digest=str(data["material_digest"]), packet_digest=str(data["packet_digest"]),
        )
        require(packet.packet_digest == digest_of(packet.payload_data()), "packet digest does not close")
        return packet

    @classmethod
    def from_json(cls, text: str) -> "ExternalPacket":
        data = json.loads(text)
        require(isinstance(data, dict), "packet root must be an object")
        return cls.from_data(data)


class XKissTransport:
    SCHEMA = "xkiss-aleph/living-v2"

    @staticmethod
    def _section(field: LivingField, index: Mapping[Address, Cell], scale: int, k: int, sheet: Sheet, ordinal: int) -> CrossSection:
        visible = index[Address(scale, k, sheet)]
        through = index[X(visible.address, field.observer_b)]
        camp, token_phase, camp_name, token_name = camp_and_token(ordinal)
        qok_depth = math.sqrt(visible.state.seam_depth * through.state.seam_depth)
        return CrossSection(
            ordinal=ordinal, same_moment=field.epoch,
            camp=camp, token_phase=token_phase, camp_name=camp_name, token_name=token_name,
            visible=visible, through=through, qok_depth=qok_depth,
        )

    @classmethod
    def encode(cls, field: LivingField, *, cut_k: int | None = None, view_sheet: Sheet = Sheet.SOMA, direction: int = 1) -> ExternalPacket:
        require(direction in (-1, 1), "direction must be +1 or -1")
        cut = field.observer_b if cut_k is None else cut_k % N_POSITIONS
        sheet = Sheet(view_sheet)
        index = field.index()
        levels: list[ScalePacket] = []
        for scale in range(field.scales):
            sections = tuple(cls._section(field, index, scale, cut + direction * ordinal, sheet, ordinal) for ordinal in range(N_POSITIONS))
            closure = (sections[-1].visible.address, sections[0].visible.address)
            levels.append(ScalePacket(scale, sections, closure))

        provisional = ExternalPacket(
            schema=cls.SCHEMA, observer_b=field.observer_b,
            cut_k=cut, view_sheet=sheet, direction=direction,
            epoch=field.epoch, scales=field.scales,
            levels=tuple(levels), history=field.history,
            material_digest=field.material_digest(), packet_digest="",
        )
        return replace(provisional, packet_digest=digest_of(provisional.payload_data()))

    @classmethod
    def decode(cls, packet: ExternalPacket) -> LivingField:
        require(packet.schema == cls.SCHEMA, "unknown X-Kiss packet schema")
        require(packet.direction in (-1, 1), "invalid read direction")
        require(packet.observer_b in range(N_POSITIONS), "observer address is outside the orbit")
        require(packet.cut_k in range(N_POSITIONS), "sequence cut is outside the orbit")
        require(packet.epoch >= 0, "epoch must be non-negative")
        require(len(packet.levels) == packet.scales, "scale packet is incomplete")
        require(packet.packet_digest == digest_of(packet.payload_data()), "packet digest is broken")
        require(len(packet.history) == packet.epoch, "epoch and passage memory diverge")
        require(tuple(trace.epoch_before for trace in packet.history) == tuple(range(packet.epoch)), "passage memory is not a contiguous radial history")
        require(all(left.material_after == right.material_before for left, right in zip(packet.history, packet.history[1:])), "successive passage memories do not join")
        require(all(trace.material_after for trace in packet.history), "a passage memory lost its material return")

        cells: dict[Address, Cell] = {}
        for expected_scale, level in enumerate(packet.levels):
            require(len(level.sections) == N_POSITIONS, "every scale requires forty cross-sections")
            require(level.scale == expected_scale, "scale order is incomplete or duplicated")
            require(level.closure == (level.sections[-1].visible.address, level.sections[0].visible.address), "the exterior line does not close into its radial orbit")
            for ordinal, section in enumerate(level.sections):
                camp, phase, camp_name, token_name = camp_and_token(ordinal)
                require(section.ordinal == ordinal, "external order is not contiguous")
                require(section.same_moment == packet.epoch, "radial simultaneity was split")
                require(section.visible.address.scale == level.scale, "visible cell crossed scales in transit")
                require(section.visible.address.sheet == packet.view_sheet, "visible sheet changed inside one read-out")
                require(section.visible.address.k == (packet.cut_k + packet.direction * ordinal) % N_POSITIONS, "external order no longer projects the declared radial cut")
                require((section.camp, section.token_phase, section.camp_name, section.token_name) == (camp, phase, camp_name, token_name), "token/camp projection does not match its relational address")
                require(section.through.address == X(section.visible.address, packet.observer_b), "a cross-section lost its X-conjugate")
                expected_depth = math.sqrt(section.visible.state.seam_depth * section.through.state.seam_depth)
                require(section.qok_depth == expected_depth, "qok depth was altered in transport")
                require(section.visible.address not in cells, "visible cell occurs more than once")
                require(section.through.address not in cells, "through-cell occurs more than once")
                cells[section.visible.address] = section.visible
                cells[section.through.address] = section.through

        field = LivingField(scales=packet.scales, observer_b=packet.observer_b, epoch=packet.epoch, cells=tuple(sorted(cells.values(), key=lambda cell: cell.address)), history=packet.history)
        require(field.material_digest() == packet.material_digest, "material write-back is not exact")
        return field

    @classmethod
    def conjugate(cls, packet: ExternalPacket) -> ExternalPacket:
        levels: list[ScalePacket] = []
        for level in packet.levels:
            raw = tuple(reversed(level.sections))
            sections: list[CrossSection] = []
            for ordinal, old in enumerate(raw):
                camp, phase, camp_name, token_name = camp_and_token(ordinal)
                sections.append(CrossSection(
                    ordinal=ordinal, same_moment=old.same_moment,
                    camp=camp, token_phase=phase, camp_name=camp_name, token_name=token_name,
                    visible=old.through, through=old.visible, qok_depth=old.qok_depth,
                ))
            closure = (sections[-1].visible.address, sections[0].visible.address)
            levels.append(ScalePacket(level.scale, tuple(sections), closure))

        new_cut = levels[0].sections[0].visible.address.k
        provisional = ExternalPacket(
            schema=packet.schema, observer_b=packet.observer_b,
            cut_k=new_cut, view_sheet=packet.view_sheet.opposite,
            direction=packet.direction, epoch=packet.epoch, scales=packet.scales,
            levels=tuple(levels), history=packet.history,
            material_digest=packet.material_digest, packet_digest="",
        )
        return replace(provisional, packet_digest=digest_of(provisional.payload_data()))


@dataclass(frozen=True, slots=True)
class Aleph:
    field: LivingField

    @property
    def identity(self) -> str:
        return self.field.material_digest()

    def read(self, *, cut_k: int | None = None, view_sheet: Sheet = Sheet.SOMA, direction: int = 1) -> ExternalPacket:
        return XKissTransport.encode(self.field, cut_k=cut_k, view_sheet=view_sheet, direction=direction)

    @classmethod
    def write(cls, packet: ExternalPacket) -> "Aleph":
        return cls(XKissTransport.decode(packet))

    def same_relation(self, packet: ExternalPacket) -> bool:
        return packet.material_digest == self.identity and XKissTransport.decode(packet) == self.field


def max_state_distance(left: LivingField, right: LivingField) -> float:
    require({cell.address for cell in left.cells} == {cell.address for cell in right.cells}, "fields do not share the same relational addresses")
    a = left.index()
    b = right.index()
    distances = []
    for address in a:
        va = a[address].state.content_vector() + (a[address].state.phase,)
        vb = b[address].state.content_vector() + (b[address].state.phase,)
        distances.extend(abs(x - y) for x, y in zip(va, vb))
    return max(distances)


def verify_living_kernel() -> dict[str, Any]:
    field = LivingField.seed(scales=2, observer_b=7)

    addresses = tuple(Address(scale, k, sheet) for scale in range(field.scales) for sheet in Sheet for k in range(N_POSITIONS))

    x_squared = all(X(X(address, field.observer_b), field.observer_b) == address for address in addresses)
    xrx = all(X(R(X(address, field.observer_b)), field.observer_b) == R_inv(address) for address in addresses)
    r40 = all(Address(address.scale, address.k + N_POSITIONS, address.sheet) == address for address in addresses)

    # Y checks
    y_definition = all(
        Y(address) == Address(
            address.scale,
            (address.k + int(address.sheet)) % N_POSITIONS,
            address.sheet,
        )
        for address in addresses
    )
    xyx = all(X(Y(X(address, field.observer_b)), field.observer_b) == Y(address) for address in addresses)
    y_counter = all(
        ((Y(address).k - address.k) % N_POSITIONS) == (1 if address.sheet == Sheet.SOMA else N_POSITIONS - 1)
        for address in addresses
    )

    packet = XKissTransport.encode(field, cut_k=11, view_sheet=Sheet.SOMA)
    packet_json = packet.to_json()
    packet_from_json = ExternalPacket.from_json(packet_json)
    reconstructed = XKissTransport.decode(packet_from_json)

    conjugate = XKissTransport.conjugate(packet)
    conjugate_twice = XKissTransport.conjugate(conjugate)
    conjugate_reconstructs_same_material = XKissTransport.decode(conjugate).material_digest() == field.material_digest()

    before = field.totals()
    stepped = LivingLaw.step(field)
    after = stepped.totals()
    unfolded = LivingLaw.reverse_last(stepped)

    stepped_packet = XKissTransport.encode(stepped, cut_k=11, view_sheet=Sheet.SOMA)
    stepped_roundtrip = ExternalPacket.from_json(stepped_packet.to_json())
    return_memory_roundtrip = XKissTransport.decode(stepped_roundtrip) == stepped

    stepped_index = stepped.index()
    first_flows = {flow.address: flow for flow in stepped.history[-1].flows}

    x_return_error = max(
        max(
            abs(flow.shadow_return_angle + first_flows[X(address, field.observer_b)].shadow_return_angle),
            abs(flow.entropy_return_angle + first_flows[X(address, field.observer_b)].entropy_return_angle),
            abs(flow.return_openness - first_flows[X(address, field.observer_b)].return_openness),
            abs(flow.return_phase - first_flows[X(address, field.observer_b)].return_phase),
        )
        for address, flow in first_flows.items()
    )

    shadow_reopened = 0
    entropy_reopened = 0
    for address, flow in first_flows.items():
        state = stepped_index[address].state
        _, shadow_before_return = rotate_pair(state.real_light_gamma, state.shadow_n, -flow.shadow_return_angle)
        _, entropy_before_return = rotate_pair(state.void_center, state.entropy, -flow.entropy_return_angle)
        shadow_reopened += abs(state.shadow_n) > abs(shadow_before_return)
        entropy_reopened += abs(state.entropy) > abs(entropy_before_return)

    cycle_steps = N_CAMPS * N_POSITIONS
    cycled = field
    cycle_norm_error = 0.0
    shadow_fluxes: list[float] = []
    entropy_fluxes: list[float] = []
    return_angle_signs: set[int] = set()

    for _ in range(cycle_steps):
        cycle_before = cycled.totals()
        cycled = LivingLaw.step(cycled)
        cycle_after = cycled.totals()
        cycle_norm_error = max(cycle_norm_error, abs(cycle_after["norm2"] - before["norm2"]))
        shadow_fluxes.append(cycle_after["shadow"] - cycle_before["shadow"])
        entropy_fluxes.append(cycle_after["entropy"] - cycle_before["entropy"])
        for flow in cycled.history[-1].flows:
            return_angle_signs.add((flow.shadow_return_angle > 0.0) - (flow.shadow_return_angle < 0.0))
            return_angle_signs.add((flow.entropy_return_angle > 0.0) - (flow.entropy_return_angle < 0.0))

    cycle_unfolded = cycled
    for _ in range(cycle_steps):
        cycle_unfolded = LivingLaw.reverse_last(cycle_unfolded)
    cycle_unfold_error = max_state_distance(field, cycle_unfolded)

    norm_error = abs(before["norm2"] - after["norm2"])
    unfold_error = max_state_distance(field, unfolded)

    same_moments = {section.same_moment for level in packet.levels for section in level.sections}

    checks: dict[str, Any] = {
        "X² = id on both sheets and all scales": x_squared,
        "X R X = R⁻¹": xrx,
        "R⁴⁰ = id on addresses": r40,
        "Y moves by sheet (+1 on SOMA, -1 on PSYCHE)": y_definition,
        "X Y X = Y (Y is invariant under conjugation with X)": xyx,
        "Y is counter-rotational on the two sheets": y_counter,
        "exact JSON read-out/write-back": reconstructed == field,
        "packet conjugation is involutive": conjugate_twice == packet,
        "conjugate view restores same Aleph": conjugate_reconstructs_same_material,
        "all scales commit in one epoch": stepped.epoch == field.epoch + 1,
        "all exterior tokens carry one radial moment": same_moments == {field.epoch},
        "twelve-channel norm conserved": norm_error < 1e-10,
        "last passage unfolds": unfold_error < 1e-12,
        "return memory survives read-out/write-back": return_memory_roundtrip,
        "X-conjugates carry opposite return": x_return_error < 1e-15,
        "return reopens shadow and entropy locally": shadow_reopened > 0 and entropy_reopened > 0,
        "return angles traverse both directions": {-1, 1}.issubset(return_angle_signs),
        "shadow and entropy circulate both ways": (min(shadow_fluxes) < 0.0 < max(shadow_fluxes) and min(entropy_fluxes) < 0.0 < max(entropy_fluxes)),
        "multicycle norm conserved": cycle_norm_error < 1e-10,
        "multicycle passage unfolds": cycle_unfold_error < 1e-11,
        "excluded entropy folds toward ∅": after["entropy"] < before["entropy"],
        "∅ centre receives excluded relation": after["center"] > before["center"],
        "shadow n becomes real light γ": (after["shadow"] < before["shadow"] and after["real_light"] > before["real_light"]),
        "seam remains open without clamp": all(cell.state.seam_depth > 0.0 for cell in stepped.cells),
        "passage memory retained": len(stepped.history) == len(field.history) + 1,
        "token chain remains composite": tuple(section.token_name for section in packet.levels[0].sections[:10]) == TOKEN_PHASES,
        "multiscale field is complete": len(field.cells) == field.scales * len(Sheet) * N_POSITIONS,
        "norm error": norm_error,
        "unfold error": unfold_error,
        "X-return error": x_return_error,
        "multicycle norm error": cycle_norm_error,
        "multicycle unfold error": cycle_unfold_error,
        "shadow reopened cells": shadow_reopened,
        "entropy reopened cells": entropy_reopened,
        "shadow flux range": (min(shadow_fluxes), max(shadow_fluxes)),
        "entropy flux range": (min(entropy_fluxes), max(entropy_fluxes)),
        "entropy before": before["entropy"],
        "entropy after": after["entropy"],
        "shadow before": before["shadow"],
        "shadow after": after["shadow"],
        "real light before": before["real_light"],
        "real light after": after["real_light"],
        "Aleph identity": Aleph(field).identity,
    }
    return checks


