class CrossSection:
    ordinal: int
    same_moment: int
    camp: int
    token_phase: int
    camp_name: str
    token_name: str
    visible: Cell
    through: Cell
    qok_depth: float

    def to_data(self) -> dict[str, Any]:
        return {
            "ordinal": self.ordinal, "same_moment": self.same_moment,
            "camp": self.camp, "token_phase": self.token_phase,
            "camp_name": self.camp_name, "token_name": self.token_name,
            "visible": self.visible.to_data(), "through": self.through.to_data(),
            "qok_depth": self.qok_depth,
